# API Server Environment Variables

# ===================
# Application
# ===================
NODE_ENV=development
PORT=3004
DEVTOOLS=true

# ===================
# MongoDB
# ===================
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=trading

# ===================
# Redis
# ===================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===================
# Authentication (Better Auth)
# ===================
APP_NAME=Investment Trading Portfolio
APP_URL=http://localhost:3004
AUTH_SECRET=your-secret-key-minimum-32-characters-long-generate-with-openssl
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3004
FRONTEND_URL=http://localhost:3000

# Social Providers (OPTIONAL)
# Google OAuth
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# Discord OAuth
# DISCORD_CLIENT_ID=your-discord-client-id
# DISCORD_CLIENT_SECRET=your-discord-client-secret

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100

# Legacy JWT (keep for backward compatibility)
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# ===================
# Upstox API (for user auth)
# ===================
UPSTOX_API_KEY=your_api_key_here
UPSTOX_API_SECRET=your_api_secret_here
UPSTOX_REDIRECT_URI=http://localhost:3004/auth/upstox/callback

# ===================
# CORS
# ===================
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true


