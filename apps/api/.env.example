# ═══════════════════════════════════════════════════════════════
# API Server — Environment Variables
# Only secrets and connection strings belong here.
# Rate limits, CORS, and other config live in MongoDB system_configs.
# ═══════════════════════════════════════════════════════════════

# ── Runtime ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3004
GRPC_PORT=50050
DEVTOOLS=true

# ── MongoDB ──────────────────────────────────────────────────
# Must include ?replicaSet=rs0 for Better Auth transactions
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Authentication (Better Auth) ─────────────────────────────
APP_NAME=Investment Trading Portfolio
APP_URL=http://localhost:3004
FRONTEND_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3004

# Generate: openssl rand -base64 32
AUTH_SECRET=your-secret-key-minimum-32-characters-long

# ── Upstox OAuth (secrets) ──────────────────────────────────
# Get from: https://account.upstox.com/developer/apps
UPSTOX_CLIENT_ID=your_api_key_here
UPSTOX_CLIENT_SECRET=your_api_secret_here
UPSTOX_API_KEY=your_api_key_here
UPSTOX_API_SECRET=your_api_secret_here
UPSTOX_REDIRECT_URI=http://localhost:3004/api/upstox/reauth/callback

# ── Social OAuth (optional) ─────────────────────────────────
# Google: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Discord: https://discord.com/developers/applications
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# ── Observability (optional) ────────────────────────────────
SENTRY_DSN=
