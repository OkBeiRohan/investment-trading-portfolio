# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=trading

# Upstox API Configuration
UPSTOX_API_KEY=your_api_key_here
UPSTOX_API_SECRET=your_api_secret_here
UPSTOX_REDIRECT_URI=http://localhost:3001/auth/callback

# ML Models Configuration
XGBOOST_MODEL_PATH=./models/xgboost.onnx
XGBOOST_THRESHOLD=0.55
XGBOOST_VERSION=1.0.0

CNN_LSTM_MODEL_PATH=./models/cnn_lstm.onnx
CNN_LSTM_SEQ_LENGTH=60
CNN_LSTM_VERSION=1.0.0

GARCH_MODEL_PATH=./models/garch.onnx
GINN_LSTM_PATH=./models/ginn_lstm.onnx
GINN_VERSION=1.0.0

SVM_MODEL_PATH=./models/svm.onnx
SVM_KERNEL=rbf
SVM_VERSION=1.0.0

STACKING_MODEL_PATH=./models/stacking.onnx
STACKING_VERSION=1.0.0

# Risk Management Configuration
MAX_DAILY_LOSS=-50000
MAX_DRAWDOWN=-100000
MAX_POSITIONS=5
MIN_CASH_RESERVE=100000
MAX_LEVERAGE=1.5
MAX_DELTA=500
MAX_VEGA=100
MAX_GAMMA=50

# Position Sizing Configuration
KELLY_MULTIPLIER=0.25
MAX_RISK_PER_TRADE=0.02

# Signal Configuration
MIN_CONFIDENCE=0.55
MAX_SIGNAL_AGE=300000

# Feature Store Configuration
FEATURES_COLLECTION=features
FEATURES_RETENTION_DAYS=90

# Training Data Configuration
TRAINING_EXPORT_PATH=./data/exports
LABEL_LOOKAHEAD_HOURS=4

# Execution Configuration
ORDER_TIMEOUT_MS=60000
ORDER_MAX_RETRIES=3
SLIPPAGE_MODEL=pessimistic

# GPU Configuration
GPU_ENABLED=true
GPU_DEVICE_ID=0

# Application Configuration
NODE_ENV=development
PORT=3001
