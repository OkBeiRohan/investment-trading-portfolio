{
  "folders": [
    { "name": "🏠 Root", "path": "." },
    { "name": "⚙️  Algo Worker", "path": "./apps/algo-worker" },
    { "name": "📡 Market Feeder", "path": "./apps/market-feeder" },
    { "name": "📊 Data Processor", "path": "./apps/data-processor" },
    { "name": "🧠 Training Pipeline", "path": "./apps/training-pipeline" },
    { "name": "🌐 Web", "path": "./apps/web" },
    { "name": "📋 Schema", "path": "./packages/schema" },
    { "name": "💾 Database", "path": "./packages/database" },
    { "name": "📈 Market SDK", "path": "./packages/market-sdk" },
  ],
  "settings": {
    "typescript.tsdk": "node_modules/typescript/lib",
    "typescript.preferences.strictNullChecks": true,
    "typescript.preferences.strictFunctionTypes": true,
    "typescript.preferences.noImplicitAny": true,
    "typescript.preferences.noImplicitThis": true,
    "typescript.preferences.noImplicitReturns": true,
    "python.defaultInterpreterPath": "${workspaceFolder}/apps/algo-worker/ml/.venv/bin/python",
    "python.analysis.typeCheckingMode": "strict",
    "python.linting.enabled": true,
    "python.linting.pylintEnabled": false,
    "python.linting.mypyEnabled": true,
    "python.formatting.provider": "black",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" },
    "editor.rulers": [80, 120],
    "files.eol": "auto",
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "terminal.integrated.defaultProfile.linux": "bash",
    "eslint.workingDirectories": [{ "mode": "auto" }],
  },
  "extensions": {
    "recommendations": [
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "ms-python.python",
      "ms-python.vscode-pylance",
      "ms-azuretools.vscode-docker",
      "mongodb.mongodb-vscode",
      "redis.redis-client",
      "prisma.prisma",
      "bradlc.vscode-tailwindcss",
    ],
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug Algo Worker",
        "type": "node",
        "request": "attach",
        "port": 9229,
        "restart": true,
        "cwd": "${workspaceFolder}/apps/algo-worker",
        "skipFiles": ["<node_internals>/**"],
      },
      {
        "name": "Debug Market Feeder",
        "type": "node",
        "request": "attach",
        "port": 9230,
        "restart": true,
        "cwd": "${workspaceFolder}/apps/market-feeder",
        "skipFiles": ["<node_internals>/**"],
      },
      {
        "name": "Debug Data Processor",
        "type": "node",
        "request": "attach",
        "port": 9231,
        "restart": true,
        "cwd": "${workspaceFolder}/apps/data-processor",
        "skipFiles": ["<node_internals>/**"],
      },
      {
        "name": "Debug API",
        "type": "node",
        "request": "attach",
        "port": 9232,
        "restart": true,
        "cwd": "${workspaceFolder}/apps/api",
        "skipFiles": ["<node_internals>/**"],
      },
      {
        "name": "Debug Web",
        "type": "node",
        "request": "attach",
        "port": 9233,
        "restart": true,
        "cwd": "${workspaceFolder}/apps/web",
        "skipFiles": ["<node_internals>/**"],
      },
      {
        "name": "Debug Python Training",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/apps/algo-worker/ml/training/train_xgboost.py",
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}/apps/algo-worker/ml",
        "env": { "PYTHONPATH": "${workspaceFolder}/apps/algo-worker/ml" },
      },
    ],
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "🗄️  Start Databases",
        "type": "shell",
        "command": "${workspaceFolder}/scripts/start-databases.ps1",
        "windows": {
          "command": "powershell.exe -ExecutionPolicy Bypass -File ${workspaceFolder}/scripts/start-databases.ps1",
        },
        "linux": {
          "command": "bash ${workspaceFolder}/scripts/start-databases.sh",
        },
        "problemMatcher": [],
        "presentation": { "reveal": "always", "panel": "new" },
      },
      {
        "label": "🛑 Stop Databases",
        "type": "shell",
        "command": "${workspaceFolder}/scripts/stop-databases.ps1",
        "windows": {
          "command": "powershell.exe -ExecutionPolicy Bypass -File ${workspaceFolder}/scripts/stop-databases.ps1",
        },
        "linux": {
          "command": "bash ${workspaceFolder}/scripts/stop-databases.sh",
        },
        "problemMatcher": [],
      },
      {
        "label": "🏗️  Build All",
        "type": "shell",
        "command": "pnpm build",
        "problemMatcher": ["$tsc"],
        "group": { "kind": "build", "isDefault": true },
      },
      {
        "label": "🧪 Test All",
        "type": "shell",
        "command": "pnpm test",
        "problemMatcher": [],
      },
      {
        "label": "🔍 Check Types",
        "type": "shell",
        "command": "pnpm check-types",
        "problemMatcher": ["$tsc"],
      },
      {
        "label": "🔄 Generate Types (TS→Python)",
        "type": "shell",
        "command": "pnpm generate-schemas",
        "problemMatcher": [],
      },
      {
        "label": "🚀 Start Development Mode",
        "type": "shell",
        "command": "${workspaceFolder}/scripts/dev-windows.ps1",
        "windows": {
          "command": "powershell.exe -ExecutionPolicy Bypass -File ${workspaceFolder}/scripts/dev-windows.ps1",
        },
        "linux": {
          "command": "bash ${workspaceFolder}/scripts/dev-archlinux.sh",
        },
        "isBackground": true,
        "problemMatcher": [],
      },
      {
        "label": "📊 Check Database Status",
        "type": "shell",
        "command": "node ${workspaceFolder}/scripts/check-databases.js",
        "problemMatcher": [],
      },
    ],
  },
}
