{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "concurrency": "16",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "generate-schemas": {
      "dependsOn": [],
      "inputs": ["src/**/*.schema.ts"],
      "outputs": ["generated/**", "types/**"],
      "env": ["API_URL", "APP_NAME"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "*.onnx",
        "*.joblib",
        "target/release/**"
      ],
      "env": [
        "API_URL",
        "APP_NAME",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "DATABASE_URL",
        "DEVTOOLS",
        "HOST",
        "MONGODB_URI",
        "PORT",
        "REDIS_URL",
        "TRUSTED_ORIGINS",
        "QUESTDB_URL",
        "SENTRY_AUTH_TOKEN"
      ]
    },
    "build:dev": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"],
      "cache": true
    },
    "build:prod": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"],
      "cache": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts"],
      "outputs": ["coverage/**"]
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.spec.ts"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start:native": {
      "cache": false
    },
    "dev:native": {
      "cache": false,
      "persistent": true
    }
  }
}
