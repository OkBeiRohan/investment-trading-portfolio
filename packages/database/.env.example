# Database Environment Variables

# Main MongoDB URI (fallback for all databases)
MONGODB_URI=mongodb://localhost:27017

# Separate database URIs for each module (optional)
# If not set, will use MONGODB_URI with different database names

# Trading Database (algo-worker)
DATABASE_TRADING_URI=mongodb://localhost:27017/trading

# User Database (api)
DATABASE_USER_URI=mongodb://localhost:27017/users

# Analytics Database (reporting)
DATABASE_ANALYTICS_URI=mongodb://localhost:27017/analytics

# Production MongoDB Atlas Example:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
# DATABASE_TRADING_URI=mongodb+srv://username:password@cluster.mongodb.net/trading?retryWrites=true&w=majority
# DATABASE_USER_URI=mongodb+srv://username:password@cluster.mongodb.net/users?retryWrites=true&w=majority
# DATABASE_ANALYTICS_URI=mongodb+srv://username:password@cluster.mongodb.net/analytics?retryWrites=true&w=majority
