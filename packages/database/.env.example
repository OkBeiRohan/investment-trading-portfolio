# ═══════════════════════════════════════════════════════════════
# Database Package — Environment Variables
# Used by MongoDBModule, QuestDBModule, and RedisModule
# ═══════════════════════════════════════════════════════════════

# ── MongoDB ──────────────────────────────────────────────────
# Base URI (database names are appended automatically by modules:
#   Account, Trading, MarketData, Logging)
# Must include ?replicaSet=rs0 for transaction support
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
