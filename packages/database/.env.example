# Database Environment Variables

# MongoDB Base URI (without database name)
# Database names are automatically appended by the modules:
# - TradingDatabaseModule → /trading
# - UserDatabaseModule → /users  
# - AnalyticsDatabaseModule → /analytics

# Local Development
MONGODB_URI=mongodb://localhost:27017

# Production MongoDB Atlas Example:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net?retryWrites=true&w=majority
