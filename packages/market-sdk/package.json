{
  "name": "@repo/market-sdk",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./*": {
      "import": "./dist/*.js",
      "require": "./dist/*.js"
    }
  },
  "scripts": {
    "proto:update": "bash scripts/fetch-proto.sh",
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@binance/connector": "^3.6.1",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.13",
    "@nestjs/event-emitter": "^3.0.1",
    "@repo/database": "workspace:*",
    "@repo/schema": "workspace:*",
    "axios": "^1.13.4",
    "dhanhq": "^1.0.6",
    "got": "^14.6.6",
    "long": "^5.3.2",
    "protobufjs": "^8.0.0",
    "ws": "^8.19.0",
    "yahoo-finance2": "^3.13.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.1",
    "@types/ws": "^8.18.1",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  }
}
