# Upstox Market SDK Environment Variables Sample
# Copy this file to .env (same directory) and fill in your credentials.
# NEVER commit the real .env file.

# OAuth client credentials (if applicable)
UPSTOX_API_KEY=your_upstox_api_key
UPSTOX_API_SECRET=your_upstox_api_secret

# Access token (sandbox or production). Required for authenticated requests.
UPSTOX_ACCESS_TOKEN=your_upstox_access_token

# Set to true to use sandbox mode (optional; defaults to false)
UPSTOX_SANDBOX=true
