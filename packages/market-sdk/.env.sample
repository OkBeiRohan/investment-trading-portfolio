# ============================================
# PLATFORM-LEVEL UPSTOX APP CREDENTIALS
# (Get from: https://upstox.com/developer/apps)
# ============================================
UPSTOX_API_KEY=your_api_key_here
UPSTOX_API_SECRET=your_api_secret_here
UPSTOX_REDIRECT_URI=http://localhost:3000/api/upstox/callback

# Environment: SANDBOX or LIVE
UPSTOX_ENVIRONMENT=SANDBOX

# ============================================
# ENCRYPTION KEY (CRITICAL - 32 CHARACTERS)
# Generate: openssl rand -base64 32 | cut -c1-32
# ============================================
ENCRYPTION_KEY=your_32_character_encryption_key

# ============================================
# DATABASE CONNECTIONS
# ============================================
MONGODB_URI=mongodb://localhost:27017/trading
REDIS_URL=redis://localhost:6379

# ============================================
# OPTIONAL: YAHOO FINANCE & BINANCE
# ============================================
# Yahoo Finance doesn't require auth
# Binance API (if using Binance provider)
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret