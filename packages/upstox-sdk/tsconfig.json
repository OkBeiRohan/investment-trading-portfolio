{
  "compilerOptions": {
    "declaration": true,
    "target": "es5",
    "module": "commonjs",
    "noImplicitAny": true,
    "outDir": "dist",
    "rootDir": ".",
    "lib": ["es6", "dom"],
    "typeRoots": ["node_modules/@types", "./types"],
    "paths": {
      "upstox-js-sdk": ["./types/upstox-js-sdk"]
    },
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["**/*.ts", "types/**/*.d.ts"],
  "exclude": ["dist", "node_modules"]
}
