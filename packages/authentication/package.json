{
  "name": "@repo/authentication",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./nestjs": {
      "import": "./dist/nestjs/index.js",
      "require": "./dist/nestjs/index.js"
    },
    "./*": {
      "import": "./dist/*.js",
      "require": "./dist/*.js"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "dev": "pnpm build --watch",
    "build": "tsc -b -v",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@better-auth/core": "^1.4.1",
    "@better-auth/passkey": "^1.4.1",
    "@nestjs/core": "^11.1.9",
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^4.0.2",
    "@repo/database": "workspace:*",
    "@repo/schema": "workspace:*",
    "better-auth": "^1.4.1",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.6",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  }
}
