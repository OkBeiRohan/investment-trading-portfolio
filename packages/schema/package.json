{
  "name": "@repo/schema",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./*": {
      "import": "./dist/*.js",
      "require": "./dist/*.js"
    }
  },
  "scripts": {
    "generate-json-schema": "tsx scripts/generate-json-schema.ts",
    "generate-schemas": "pnpm generate-json-schema",
    "check-types": "tsc --noEmit",
    "dev": "pnpm build --watch",
    "build": "tsc -b -v",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "eslint": "^9.39.1",
    "tsx": "^4.20.6",
    "zod-to-json-schema": "^3.25.0"
  }
}
