{
  "version": "0.0.3",
  "name": "investment-trading-portfolio",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:dev": "turbo run build:dev",
    "build:prod": "turbo run build:prod",
    "dev": "turbo run dev",
    "dev:win": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-windows.ps1",
    "dev:arch": "bash ./scripts/dev-archlinux.sh",
    "dev:native": "turbo run dev:native",
    "start:native": "node scripts/start-native.js",
    "stop:native": "node scripts/stop-native.js",
    "status": "pm2 status && node scripts/check-databases.js",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "generate-schemas": "turbo run generate-schemas",
    "deploy:win": "powershell -ExecutionPolicy Bypass -File ./scripts/pm2-deploy-windows.ps1",
    "deploy:arch": "bash ./scripts/pm2-deploy-archlinux.sh",
    "clean": "turbo run clean && rimraf node_modules",
    "clean:all": "powershell -ExecutionPolicy Bypass -File ./scripts/clean-all.ps1"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "prettier": "^3.7.4",
    "turbo": "^2.6.3",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=18"
  }
}
