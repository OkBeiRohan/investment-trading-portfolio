# ═══════════════════════════════════════════════════════════════
# Notification Service — Environment Variables
# Only secrets and connection strings belong here.
# Email templates, channel settings, etc. live in
# MongoDB system_configs.
# ═══════════════════════════════════════════════════════════════

# ── Runtime ──────────────────────────────────────────────────
NODE_ENV=development
GRPC_PORT=50054

# ── MongoDB ──────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── SMTP (secrets — for email notifications) ─────────────────
# Provider settings (host, port, etc.) are in MongoDB system_configs.
# Only credentials go here.
SMTP_USER=
SMTP_PASS=

# ── Observability (optional) ────────────────────────────────
SENTRY_DSN=
