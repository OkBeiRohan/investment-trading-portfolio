{
  "name": "@repo/compute-engine",
  "version": "0.1.0",
  "private": true,
  "main": "index.node",
  "types": "index.d.ts",
  "napi": {
    "name": "compute-engine",
    "triples": {
      "defaults": true,
      "additional": [
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu"
      ]
    }
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "cargo test",
    "lint": "cargo clippy -- -D warnings",
    "format": "cargo fmt",
    "dev": "cargo build --release && node -e \"const { computeFeaturesNapi } = require('./index.node'); console.log('Loaded successfully')\""
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0"
  },
  "files": [
    "index.node",
    "index.d.ts"
  ]
}
