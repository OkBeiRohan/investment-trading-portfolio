# Data Processor Environment Variables

# ===================
# Application
# ===================
NODE_ENV=development
GRPC_PORT=50053

# ===================
# MongoDB (Feature Storage)
# ===================
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=trading

# ===================
# QuestDB (Time-Series Data)
# ===================
QUESTDB_HOST=localhost
QUESTDB_PG_PORT=8812
QUESTDB_ILP_PORT=9000
QUESTDB_DATABASE=qdb
QUESTDB_USER=admin
QUESTDB_PASSWORD=quest

# ===================
# Redis (Market Data Subscription)
# ===================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===================
# Feature Engineering
# ===================
# Window sizes for rolling calculations
VOL_WINDOW_5D=5
VOL_WINDOW_10D=10
VOL_WINDOW_20D=20

# Technical indicators
RSI_PERIOD=14
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

# Moving averages
SMA_PERIOD_20=20
SMA_PERIOD_50=50
EMA_PERIOD_20=20
EMA_PERIOD_50=50

# ===================
# Processing Configuration
# ===================
PROCESSING_INTERVAL_MS=5000
BATCH_SIZE=100

# ===================
# Logging
# ===================
LOG_LEVEL=info
LOG_FILE_PATH=./logs/data-processor.log