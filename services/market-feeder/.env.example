# Market Feeder Environment Variables

# ===================
# Application
# ===================
NODE_ENV=development
GRPC_PORT=50052
HISTORY_SAVER_ENABLED=true

# ===================
# Sentry (Error Tracking & Performance)
# ===================
# Get your DSN from https://sentry.io/settings/projects/<project>/keys/
SENTRY_DSN=https://your_sentry_dsn@o1234567.ingest.sentry.io/1234567

# ===================
# QuestDB (Time-Series Storage)
# ===================
QUESTDB_HOST=localhost
QUESTDB_PG_PORT=8812
QUESTDB_ILP_PORT=9000
QUESTDB_USER=admin
QUESTDB_PASSWORD=quest
QUESTDB_POOL_SIZE=20
QUESTDB_DATABASE=qdb

# ===================
# Redis (Pub/Sub for downstream apps)
# ===================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===================
# Upstox WebSocket
# ===================
UPSTOX_API_KEY=your_api_key_here
UPSTOX_API_SECRET=your_api_secret_here
UPSTOX_ACCESS_TOKEN=your_access_token_here
UPSTOX_ENVIRONMENT=sandbox
ENCRYPTION_KEY=your_encryption_key_here

# ===================
# Market Data Configuration
# ===================
# Instruments to subscribe (comma-separated)
INSTRUMENTS=NSE_INDEX|Nifty 50,NSE_INDEX|Nifty Bank

# WebSocket feed types
FEED_TYPES=ltpc,full,option_greeks

# ===================
# Batch Configuration
# ===================
# Buffer size before flush to QuestDB
BATCH_SIZE=100
BATCH_FLUSH_INTERVAL_MS=1000

# ===================
# Logging
# ===================
LOG_LEVEL=info
LOG_FILE_PATH=./logs/market-feeder.log

# ===================
# Feature Computation
# ===================
# Enable batch feature computation for ML training
FEATURE_COMPUTATION_ENABLED=false

# Instruments to compute features for (comma-separated)
FEATURE_COMPUTATION_INSTRUMENTS=NSE_INDEX|Nifty 50,NSE_INDEX|Nifty Bank

# Compute engine binary path (optional, auto-detected)
# COMPUTE_ENGINE_PATH=../../packages/compute-engine/target/release/compute-engine

# ===================
# Strike Selector (Institutional-Grade Option Selection)
# ===================
# Enable strike selector module
STRIKE_SELECTOR_ENABLED=false

# Auto-run strike selection on app startup (uses nearest expiry)
AUTO_BOOTSTRAP_STRIKE_SELECTOR=false

# Expected Nifty move in points (+ve = bullish, -ve = bearish)
# Example: 50 means you expect Nifty to move up 50 points
EXPECTED_MOVE=50

# Holding period in days (0.25 = 6 hours, 0.5 = 12 hours, 1 = full day)
HOLDING_PERIOD_DAYS=1

# Option type to analyze: CE (calls), PE (puts), or BOTH
OPTION_TYPE=BOTH

# Maximum capital to risk per trade (0.05 = 5%)
MAX_RISK_PERCENT=0.05

# Specific expiry date (YYYY-MM-DD), leave empty for nearest
# EXPIRY_DATE=2024-01-25

# Delta filters (0.05-0.95 filters out very far OTM and deep ITM options)
MIN_DELTA=0.05
MAX_DELTA=0.95

# Minimum open interest filter (for liquidity)
MIN_OI=1000

# Number of top strikes to display
TOP_N=10

# Default balance if funds API fails (for testing)
STRIKE_SELECTOR_DEFAULT_BALANCE=50000

# Output JSON result (for programmatic use)
OUTPUT_JSON=false

# ===================
# Global Data Providers (Optional)
# ===================
# Alpha Vantage — US Treasury yields, forex
# Sign up: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Finnhub — Market news & sentiment
# Sign up: https://finnhub.io/register
FINNHUB_API_KEY=

# ===================
# Ingestion Layer
# ===================
# Enable ingestion module
INGESTION_ENABLED=true

# Max expired futures to process per sync
MAX_EXPIRED_FUTURES=100

# Max options to backfill per run
MAX_OPTIONS=200

# Max historical expiries to scan
MAX_EXPIRIES=52

# ===================
# Scheduler (Cron Jobs)
# ===================
# Enable nightly backfill cron
SCHEDULER_NIGHTLY_BACKFILL_ENABLED=false
SCHEDULER_NIGHTLY_BACKFILL_LOOKBACK_DAYS=7

# Enable intraday fetch / EOD reconciliation
SCHEDULER_INTRADAY_FETCH_ENABLED=false

