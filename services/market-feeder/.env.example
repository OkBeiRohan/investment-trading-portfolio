# ═══════════════════════════════════════════════════════════════
# Market Feeder — Environment Variables
# Only secrets and connection strings belong here.
# All other config (schedules, batch sizes, instrument lists,
# ingestion params, etc.) lives in MongoDB system_configs
# and is managed via DbConfigService.
# ═══════════════════════════════════════════════════════════════

# ── Runtime ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3005
GRPC_PORT=50052

# ── MongoDB ──────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0

# ── QuestDB ──────────────────────────────────────────────────
QUESTDB_HOST=localhost
QUESTDB_PG_PORT=8812
QUESTDB_ILP_PORT=9009
QUESTDB_USER=admin
QUESTDB_PASSWORD=quest
QUESTDB_DATABASE=qdb
QUESTDB_POOL_SIZE=20

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Authentication (required by @repo/authentication) ────────
APP_NAME=Investment Trading Portfolio
FRONTEND_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000

# Generate: openssl rand -base64 32
AUTH_SECRET=your-secret-key-minimum-32-characters-long

# ── Upstox (secrets) ─────────────────────────────────────────
# Get from: https://account.upstox.com/developer/apps
# "API Key" is the same as "Client ID" in Upstox terminology
UPSTOX_API_KEY=your_api_key_here
UPSTOX_API_SECRET=your_api_secret_here
UPSTOX_REDIRECT_URI=http://localhost:3004/api/upstox/reauth/callback

# ── Security ─────────────────────────────────────────────────
# Generate: openssl rand -base64 32 | cut -c1-32
ENCRYPTION_KEY=your_32_character_encryption_key

# ── Global Data Provider Secrets (optional) ──────────────────
# Alpha Vantage — US Treasury yields, forex
# Sign up: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Finnhub — Market news & sentiment
# Sign up: https://finnhub.io/register
FINNHUB_API_KEY=

# ── Observability (optional) ────────────────────────────────
# Get from: https://sentry.io → Settings → Projects → Client Keys
SENTRY_DSN=

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=market-feeder
